// Build the 8-page Chinese RS+BCH cascade draft deck with pptxgenjs.
// Palette: white-dominant, light-green bordered — matches Beijing Institute
// of Technology's official emblem colors (VI manual A1-08: PANTONE 347C
// primary green / 349C dark green / 1535C brown).
// Heavy technical content lives in pre-rendered PNG diagrams (fonts baked in);
// native text is limited to titles / short bullets / stat callouts with slack.

const pptxgen = require("pptxgenjs");
const fs = require("fs");
const path = require("path");

const ROOT = "/Users/chenshiyang.10/workspace/llosd_reproduction";
const ASSETS = path.join(ROOT, "hard_cascade/docs/ppt_build/assets");
const HCFIG = path.join(ROOT, "hard_cascade/figures");
const RSFIG = path.join(ROOT, "rs_bch_cascade/figures");
const OUT = path.join(ROOT, "hard_cascade/docs/rs_bch_cascade_deck.pptx");

// ---- palette (BIT official VI colors: A1-08, PANTONE 347C/349C/1535C) ----
const GREEN      = "009A44"; // PANTONE 347C 100% — primary school green (borders, accents)
const GREEN_75   = "14AE68"; // 75% tint — softer light-green border
const GREEN_50   = "89C997"; // 50% tint
const GREEN_25   = "CBE4CE"; // 25% tint
const GREEN_DARK = "015C31"; // PANTONE 349C — secondary dark green (titles, strong text)
const BROWN      = "A23E0A"; // PANTONE 1535C — secondary brown (caution / caveat accent)
const INK = "1A1A1A";
const GRAY = "5C6670";
const GRAYL = "8A929B";
const WHITE = "FFFFFF";
const GREEN_WASH = "EEF8F0";  // very light green card background
const GREEN_TINT = "DCF0E1";  // slightly stronger green card background
const BROWN_TINT = "FBEEE6";  // light brown card background (caveat cards)
const GRAY_TINT = "F2F3F4";   // neutral card background (de-emphasized / "traditional")

const FONT = "Microsoft YaHei"; // CJK-capable; LibreOffice glyph-falls back for QA
const FONT_NUM = "Arial";

const pres = new pptxgen();
pres.defineLayout({ name: "W", width: 13.333, height: 7.5 });
pres.layout = "W";
pres.author = "陈诗阳";
pres.title = "硬判决/软判决 RS+BCH 级联码低时延译码";

const W = 13.333, H = 7.5, M = 0.6;

// image aspect ratios (width/height), measured
const AR = {
  basics: 2174 / 839,
  cascade: 2123 / 980,
  pipeline: 2159 / 1060,
  lagrange: 2134 / 940,
  latency: 2143 / 899,
  interleave: 2279 / 1237,
  ber: 980 / 700,        // n255_scheme_a_ber
  fer_all: 2520 / 700,   // all_configs_fer
  il_ber: 2380 / 728,    // interleave_ber_v4
  il_gain: 1260 / 700,   // interleave_gain_v4
  kpi: 1680 / 630,       // n255_kpi_bars
};

// place an image inside a max box, centered, aspect preserved. returns actual rect
function fitImg(slide, file, ar, x, y, maxW, maxH, align) {
  let w = maxW, h = w / ar;
  if (h > maxH) { h = maxH; w = h * ar; }
  let px = x;
  if (align === "center") px = x + (maxW - w) / 2;
  else if (align === "right") px = x + (maxW - w);
  const py = y + (maxH - h) / 2;
  slide.addImage({ path: file, x: px, y: py, w, h });
  return { x: px, y: py, w, h };
}

// slide title (top-left), no underline per design rules
function title(slide, txt, opts) {
  opts = opts || {};
  slide.addText(txt, {
    x: M, y: 0.34, w: W - 2 * M, h: 0.9,
    fontFace: FONT, fontSize: opts.size || 30, bold: true,
    color: opts.color || GREEN_DARK, align: "left", valign: "middle", margin: 0,
  });
}

// small kicker label above/near title
function kicker(slide, txt, color) {
  slide.addText(txt, {
    x: M, y: 0.06, w: W - 2 * M, h: 0.32, fontFace: FONT, fontSize: 12.5,
    bold: true, color: color || GREEN, align: "left", valign: "middle",
    margin: 0, charSpacing: 2,
  });
}

// rounded card — white by default, light-green border
function card(slide, x, y, w, h, fill, line) {
  slide.addShape(pres.ShapeType.roundRect, {
    x, y, w, h, rectRadius: 0.09,
    fill: { color: fill }, line: line === undefined ? { color: GREEN_75, width: 1.25 } :
      (line ? { color: line, width: 1.25 } : { type: "none" }),
  });
}

// number-badge circle with a digit
function badge(slide, x, y, d, r, fill) {
  r = r || 0.34;
  slide.addShape(pres.ShapeType.ellipse, {
    x, y, w: r * 2, h: r * 2, fill: { color: fill || GREEN }, line: { type: "none" },
  });
  slide.addText(String(d), {
    x, y, w: r * 2, h: r * 2, fontFace: FONT, fontSize: 15, bold: true,
    color: WHITE, align: "center", valign: "middle", margin: 0,
  });
}

// thin accent band used in place of a solid-color slide background
function topBand(slide, color) {
  slide.addShape(pres.ShapeType.rect, {
    x: 0, y: 0, w: W, h: 0.14, fill: { color: color || GREEN }, line: { type: "none" },
  });
}

// ============================================================ SLIDE 1 — cover / 背景
(function () {
  const s = pres.addSlide();
  s.background = { color: WHITE };
  topBand(s, GREEN);
  // right-side illustrative card using the basics diagram
  const cardX = 7.0, cardW = W - cardX - M;
  card(s, cardX, 2.55, cardW, 3.35, WHITE, GREEN_75);
  fitImg(s, path.join(ASSETS, "fig_rs_bch_basics.png"), AR.basics,
    cardX + 0.15, 2.7, cardW - 0.3, 3.05, "center");

  s.addText("华为横向 · FEC 前向纠错", {
    x: M, y: 0.9, w: 6.2, h: 0.4, fontFace: FONT, fontSize: 13.5, bold: true,
    color: GREEN, align: "left", margin: 0, charSpacing: 2,
  });
  s.addText("RS + BCH 级联码\n低时延译码方案", {
    x: M, y: 1.35, w: 6.3, h: 1.9, fontFace: FONT, fontSize: 40, bold: true,
    color: GREEN_DARK, align: "left", margin: 0, lineSpacingMultiple: 1.02,
  });
  s.addText([
    { text: "背景：", options: { bold: true, color: GREEN } },
    { text: "PAM4 高速链路的误码需要强纠错，但传统 OSD 类译码", options: {} },
    { text: "延迟高、难并行", options: { bold: true, color: BROWN } },
    { text: "。", options: {} },
  ], {
    x: M, y: 3.5, w: 6.1, h: 0.9, fontFace: FONT, fontSize: 15, color: INK,
    align: "left", margin: 0, lineSpacingMultiple: 1.15, valign: "top",
  });

  // three benefit chips
  const chips = [
    ["纠错更强", "外码 RS 兜底内码残余错误，级联叠加纠错力"],
    ["延迟更低", "Lagrange 插值取代高斯消元，关键路径大幅缩短"],
    ["抗突发", "矩阵交织把突发错误打散到多个码字"],
  ];
  const cy = 4.75, cw = 1.98, gap = 0.16;
  chips.forEach((c, i) => {
    const x = M + i * (cw + gap);
    card(s, x, cy, cw, 1.35, GREEN_WASH, GREEN_75);
    s.addText(c[0], { x: x + 0.12, y: cy + 0.12, w: cw - 0.24, h: 0.38,
      fontFace: FONT, fontSize: 14.5, bold: true, color: GREEN_DARK, align: "left", margin: 0 });
    s.addText(c[1], { x: x + 0.12, y: cy + 0.5, w: cw - 0.24, h: 0.78,
      fontFace: FONT, fontSize: 10.5, color: INK, align: "left", margin: 0,
      valign: "top", lineSpacingMultiple: 1.05 });
  });

  s.addText("陈诗阳 · 2026-07-27", {
    x: M, y: 6.75, w: 6, h: 0.35, fontFace: FONT, fontSize: 11.5, color: GRAYL,
    align: "left", margin: 0,
  });
  s.addNotes("开场：这页讲清楚我们为什么做 RS+BCH 级联码。高速 PAM4 链路误码需要强纠错，传统软判译码延迟高。我们的方案在保证纠错增益的同时，用 Lagrange 插值把译码延迟降下来，并用交织抗突发。右图对比 RS(符号级)与 BCH(比特级)的互补性。");
})();

// ============================================================ SLIDE 2 — 构造 + 完整链路 + 开销
(function () {
  const s = pres.addSlide();
  s.background = { color: WHITE };
  kicker(s, "构造方法 · 完整链路 · 开销", GREEN);
  title(s, "级联码怎么构造：外码 RS ⊕ 内码 BCH");

  // cascade structure diagram (top)
  fitImg(s, path.join(ASSETS, "fig_cascade_struct.png"), AR.cascade,
    M, 1.2, W - 2 * M, 2.35, "center");

  // pipeline diagram (middle)
  fitImg(s, path.join(ASSETS, "fig_pipeline.png"), AR.pipeline,
    M, 3.5, 8.35, 3.5, "left");

  // overhead callout card (right)
  const ox = 9.2, ow = W - ox - M;
  card(s, ox, 3.72, ow, 3.2, GREEN_WASH, GREEN_75);
  s.addText("开销（码率 ≈ 0.88）", {
    x: ox + 0.2, y: 3.85, w: ow - 0.4, h: 0.4, fontFace: FONT, fontSize: 15,
    bold: true, color: GREEN_DARK, align: "left", margin: 0,
  });
  s.addText([
    { text: "名义开销 12%", options: { bold: true, color: GREEN_DARK, fontFace: FONT } },
    { text: "（外码 0.937 × 内码 0.937 ≈ 0.879）", options: { fontFace: FONT } },
  ], { x: ox + 0.2, y: 4.28, w: ow - 0.4, h: 0.55, fontSize: 12.5, color: INK,
       align: "left", margin: 0, valign: "top", lineSpacingMultiple: 1.05 });
  s.addText([
    { text: "实测有效开销 ≈ 17–18%", options: { bold: true, color: BROWN, fontFace: FONT, breakLine: true } },
    { text: "RS 比特流不能整除 BCH 块 → 需零填充，有效码率降到 0.82–0.83。", options: { fontFace: FONT } },
  ], { x: ox + 0.2, y: 4.95, w: ow - 0.4, h: 1.0, fontSize: 12, color: INK,
       align: "left", margin: 0, valign: "top", lineSpacingMultiple: 1.08 });
  s.addText("★ 唯有精确整除的码型（如 KP4：2×544×10 = 80×136）才真正达到 ≈11% 开销、零填充。", {
    x: ox + 0.2, y: 6.0, w: ow - 0.4, h: 0.85, fontFace: FONT, fontSize: 11,
    color: GREEN_DARK, bold: true, align: "left", margin: 0, valign: "top",
    lineSpacingMultiple: 1.08,
  });
  s.addNotes("这页讲构造和开销。上图：信息符号先过外码 RS 编码(符号级校验)，串行成比特后分块做内码 BCH 编码，再进信道。下图是完整链路：编码→PAM4调制→AWGN信道→PAM4解调(算LLR)→BCH内码译码(LLOSD)→RS外码译码(LCC-BR/BM)。右侧诚实交代开销：名义12%，但因零填充实测有效开销约17-18%，只有精确整除的码型才真达约11%。这点华为工程师会问，要主动说明。");
})();

// ============================================================ SLIDE 3 — 译码算法 + Lagrange
(function () {
  const s = pres.addSlide();
  s.background = { color: WHITE };
  kicker(s, "译码算法原理 · 核心创新", GREEN);
  title(s, "译码怎么做：Lagrange 插值取代高斯消元");

  // lagrange diagram (right, dominant)
  fitImg(s, path.join(ASSETS, "fig_lagrange.png"), AR.lagrange,
    5.4, 1.35, W - 5.4 - M, 4.0, "center");

  // left explanation
  const lx = M, lw = 4.55;
  card(s, lx, 1.45, lw, 5.4, GREEN_WASH, GREEN_75);
  s.addText("两级译码", {
    x: lx + 0.22, y: 1.6, w: lw - 0.44, h: 0.42, fontFace: FONT, fontSize: 16,
    bold: true, color: GREEN_DARK, align: "left", margin: 0,
  });
  s.addText([
    { text: "内码 BCH：LLOSD（软判有序统计）", options: { bold: true, breakLine: true } },
    { text: "外码 RS：LCC-BR（Chase 软判）或 BM（硬判）", options: { bold: true, breakLine: true } },
  ], { x: lx + 0.22, y: 2.05, w: lw - 0.44, h: 0.95, fontFace: FONT, fontSize: 12.5,
       color: INK, align: "left", margin: 0, valign: "top", lineSpacingMultiple: 1.15 });

  s.addText("关键洞察（IEEE TIT 2025）", {
    x: lx + 0.22, y: 3.05, w: lw - 0.44, h: 0.4, fontFace: FONT, fontSize: 14,
    bold: true, color: BROWN, align: "left", margin: 0,
  });
  s.addText([
    { text: "BCH ⊂ RS", options: { bold: true, color: BROWN } },
    { text: "，故 BCH 可借 RS 的代数（Lagrange 插值）来译码，把 OSD 里最贵的高斯消元换成插值求值。", options: {} },
  ], { x: lx + 0.22, y: 3.45, w: lw - 0.44, h: 1.0, fontFace: FONT, fontSize: 12.5,
       color: INK, align: "left", margin: 0, valign: "top", lineSpacingMultiple: 1.15 });

  s.addText("我们的扩展：共享 Lagrange", {
    x: lx + 0.22, y: 4.5, w: lw - 0.44, h: 0.4, fontFace: FONT, fontSize: 14,
    bold: true, color: GREEN_DARK, align: "left", margin: 0,
  });
  s.addText([
    { text: "内外码同在一个 GF(2ᵐ) 上，可共享：α 幂表、两两差值表、分母积、基函数结构。", options: { breakLine: true } },
    { text: "好处：免主元、易并行、关键路径短 → 延迟低。", options: { bold: true, color: GREEN_DARK } },
  ], { x: lx + 0.22, y: 4.9, w: lw - 0.44, h: 1.8, fontFace: FONT, fontSize: 12.5,
       color: INK, align: "left", margin: 0, valign: "top", lineSpacingMultiple: 1.18 });
  s.addNotes("这页是译码算法核心。传统 OSD 要对 k×k 矩阵做高斯消元：逐行、依赖上一行、需选主元，是串行关键路径，延迟高、难并行。IEEE TIT 2025 的洞察是 BCH 是 RS 的子码，可用 RS 的 Lagrange 插值来译码——把重编码看成多项式插值，免掉高斯消元。基函数与求值都可并行、无主元依赖。我们的扩展：内码 LLOSD 与外码 LCC-BR 同在一个有限域上，可共享 α 幂表、差值表、分母积、基函数结构，进一步省开销。右图对比串行消元 vs 并行插值。");
})();

// ============================================================ SLIDE 4 — 延迟分析
(function () {
  const s = pres.addSlide();
  s.background = { color: WHITE };
  kicker(s, "延迟分析", GREEN);
  title(s, "延迟：为什么低，以及怎么量化");

  // latency mechanism diagram (top)
  fitImg(s, path.join(ASSETS, "fig_latency.png"), AR.latency,
    M, 1.25, W - 2 * M, 2.75, "center");

  // three quantification cards
  const cy = 4.25, cw = (W - 2 * M - 2 * 0.3) / 3;
  const cards = [
    ["怎么量化", GREEN_DARK, GREEN_WASH,
      "延迟 = 关键路径上的 GF 运算级数 × 单级时钟。并行度 P 提升，本方法关键路径远短于逐行消元。"],
    ["软基线 (LCC-BR)", GREEN_DARK, GREEN_TINT,
      "对比同为软判的 RS-LCC-BR：低 SNR 段本方案延迟 −20% ~ −27%，高 SNR ≈ +7%，KPI（≤+10%）达标。"],
    ["硬基线 (RS-BM)", BROWN, BROWN_TINT,
      "对比纯硬判 RS-BM：9.5 dB 时 976 µs → 12051 µs（+1134%）。软判法对硬判基线本就贵，需 Direct 硬判路线达标。"],
  ];
  cards.forEach((c, i) => {
    const x = M + i * (cw + 0.3);
    card(s, x, cy, cw, 2.65, c[2], i === 2 ? BROWN : GREEN_75);
    s.addText(c[0], { x: x + 0.18, y: cy + 0.16, w: cw - 0.36, h: 0.42,
      fontFace: FONT, fontSize: 14.5, bold: true, color: c[1], align: "left", margin: 0 });
    s.addText(c[3], { x: x + 0.18, y: cy + 0.66, w: cw - 0.36, h: 1.85,
      fontFace: FONT, fontSize: 12, color: INK, align: "left", margin: 0,
      valign: "top", lineSpacingMultiple: 1.18 });
  });
  s.addNotes("延迟这页两件事：为什么低、怎么算。为什么低——上图：传统高斯消元关键路径长(每步依赖上一步)，Lagrange+并行把关键路径缩短，其余计算并行展开。怎么量化——延迟=关键路径GF运算级数×单级时钟。下面三张卡是诚实的KPI结论：跟软判基线LCC-BR比，低SNR延迟降20-27%、达标；跟硬判基线BM比，因为拿软判法对硬判基线本来就贵，会+1134%，这不是bug，是要用Direct硬判路线去满足硬判KPI。华为若问延迟一定要说清是跟谁比。");
})();

// ============================================================ SLIDE 5 — 交织
(function () {
  const s = pres.addSlide();
  s.background = { color: WHITE };
  kicker(s, "交织 · 抗突发错误", GREEN);
  title(s, "交织：怎么交织，为什么能抗突发");

  // interleave mechanism diagram (left, dominant)
  fitImg(s, path.join(ASSETS, "fig_interleave.png"), AR.interleave,
    M, 1.3, 8.0, 5.55, "left");

  // right: why + gain
  const rx = 8.9, rw = W - rx - M;
  card(s, rx, 1.4, rw, 2.55, GREEN_WASH, GREEN_75);
  s.addText("怎么交织（三步矩阵交织）", {
    x: rx + 0.2, y: 1.54, w: rw - 0.4, h: 0.4, fontFace: FONT, fontSize: 14,
    bold: true, color: GREEN_DARK, align: "left", margin: 0,
  });
  s.addText([
    { text: "① RS 符号重排", options: { bold: true } },
    { text: "，残余错均摊到各 RS 码字；", options: {} },
    { text: "② 按列写、按行做 BCH 编码", options: { bold: true } },
    { text: "；", options: {} },
    { text: "③ 逐列发送", options: { bold: true } },
    { text: "，把突发按列宽 w 打散到不同 BCH 码字。", options: {} },
  ], { x: rx + 0.2, y: 1.98, w: rw - 0.4, h: 1.9, fontFace: FONT, fontSize: 12.5,
       color: INK, align: "left", margin: 0, valign: "top", lineSpacingMultiple: 1.2 });

  card(s, rx, 4.1, rw, 2.75, GREEN_TINT, GREEN_75);
  s.addText("为什么抗突发", {
    x: rx + 0.2, y: 4.24, w: rw - 0.4, h: 0.4, fontFace: FONT, fontSize: 14,
    bold: true, color: GREEN_DARK, align: "left", margin: 0,
  });
  s.addText([
    { text: "w=1bit 时，任意长突发在每个 BCH 码字里至多 1 个错", options: { bold: true, color: GREEN_DARK, breakLine: true } },
    { text: "，正落在 t=1 可纠范围内。", options: { breakLine: true } },
    { text: "代价：零有限域运算、零码率损失——只是读写地址重排，是“近免费”的增益。", options: {} },
  ], { x: rx + 0.2, y: 4.68, w: rw - 0.4, h: 2.05, fontFace: FONT, fontSize: 12,
       color: INK, align: "left", margin: 0, valign: "top", lineSpacingMultiple: 1.2 });
  s.addNotes("交织这页。怎么交织——三步矩阵交织：先重排RS符号让残余错均摊，再按列写按行做BCH编码，最后逐列发送。图上半是不交织：整段突发全压在一个BCH码字里，超出t=1直接失败。下半是w=1bit交织：突发被打散，每个BCH码字至多1个错，全部可纠。为什么抗突发就在这个打散机理。而且交织只是地址重排，没有有限域运算、不损码率，是近免费的增益。这块复现的是APCC 2022那篇论文，码型正好就是我们的KP4配置。");
})();

// ============================================================ SLIDE 6 — 仿真结果
(function () {
  const s = pres.addSlide();
  s.background = { color: WHITE };
  kicker(s, "仿真结果 · PAM4-AWGN", GREEN);
  title(s, "性能：n=127 与 n=255 两种码长");

  // two figures side by side
  s.addText("n=255-A：级联 vs 纯 RS（BER-SNR）", {
    x: M, y: 1.25, w: 6.0, h: 0.4, fontFace: FONT, fontSize: 14, bold: true,
    color: GREEN_DARK, align: "left", margin: 0,
  });
  fitImg(s, path.join(RSFIG, "n255_scheme_a_ber.png"), AR.ber,
    M, 1.7, 6.0, 3.7, "center");

  s.addText("三种配置总览（FER-SNR）", {
    x: 6.9, y: 1.25, w: 6.0, h: 0.4, fontFace: FONT, fontSize: 14, bold: true,
    color: GREEN_DARK, align: "left", margin: 0,
  });
  fitImg(s, path.join(RSFIG, "all_configs_fer.png"), AR.fer_all,
    6.9, 2.15, W - 6.9 - M, 2.8, "center");

  // observation strip
  card(s, M, 5.55, W - 2 * M, 1.35, BROWN_TINT, BROWN);
  s.addText([
    { text: "关键观察（诚实）：", options: { bold: true, color: BROWN } },
    { text: "存在门限效应——低 SNR（6–7.5 dB）级联 ", options: {} },
    { text: "劣于", options: { bold: true, color: BROWN } },
    { text: " 纯 RS；高 SNR（≥8 dB）反超，9.5 dB 时级联 BER=0、纯 RS 仍有 2.2×10⁻⁴。", options: {} },
    { text: " BCH t=1 的配置（n255-B）几乎无级联增益 → 建议 t≥2。", options: { bold: true, color: GREEN_DARK, breakLine: false } },
  ], { x: M + 0.2, y: 5.68, w: W - 2 * M - 0.4, h: 1.1, fontFace: FONT,
       fontSize: 12.5, color: INK, align: "left", margin: 0, valign: "middle",
       lineSpacingMultiple: 1.15 });
  s.addNotes("仿真结果，两种码长。左图 n=255-A 级联 vs 纯 RS 的 BER-SNR，右图三种配置的 FER 总览。要诚实讲门限效应：低SNR段级联反而比纯RS差(内码BCH误纠引入额外错)，到8dB以上级联反超，9.5dB级联BER已到0而纯RS还有2e-4。还有一点：BCH t=1的配置(n255-B)几乎没有级联增益，所以建议内码至少t≥2。这些都是华为工程师会追问的，主动摆出来更可信。");
})();

// ============================================================ SLIDE 7 — 传统 vs 我们
(function () {
  const s = pres.addSlide();
  s.background = { color: WHITE };
  kicker(s, "对比 · 相对传统方法", GREEN);
  title(s, "和传统“先译 BCH 再译 RS”比，好在哪");

  // comparison: two columns
  const colW = (W - 2 * M - 0.4) / 2;
  const ty = 1.35;
  // traditional
  card(s, M, ty, colW, 3.15, GRAY_TINT, GRAYL);
  s.addText("传统方法", { x: M + 0.22, y: ty + 0.16, w: colW - 0.44, h: 0.45,
    fontFace: FONT, fontSize: 17, bold: true, color: GRAY, align: "left", margin: 0 });
  [
    "内码 BCH 硬判译码，再把结果交给外码 RS",
    "OSD 类重编码用高斯消元：串行、需选主元",
    "关键路径 ∝ k，难并行 → 延迟高",
    "内外码各算各的，无中间结果复用",
  ].forEach((t, i) => {
    s.addText(t, { x: M + 0.5, y: ty + 0.72 + i * 0.56, w: colW - 0.72, h: 0.52,
      fontFace: FONT, fontSize: 12.5, color: INK, align: "left", margin: 0,
      valign: "middle", bullet: { code: "2013", indent: 14 } });
  });

  // ours
  card(s, M + colW + 0.4, ty, colW, 3.15, GREEN_WASH, GREEN_75);
  const ox = M + colW + 0.4;
  s.addText("本方案", { x: ox + 0.22, y: ty + 0.16, w: colW - 0.44, h: 0.45,
    fontFace: FONT, fontSize: 17, bold: true, color: GREEN_DARK, align: "left", margin: 0 });
  [
    "内码 LLOSD 软判 + 外码 LCC-BR/BM，纠错增益 ≥1 dB",
    "Lagrange 插值取代高斯消元：免主元、可并行",
    "关键路径大幅缩短 → 延迟低",
    "内外码共享 Lagrange 代数结构，省重复计算",
  ].forEach((t, i) => {
    s.addText(t, { x: ox + 0.5, y: ty + 0.72 + i * 0.56, w: colW - 0.72, h: 0.52,
      fontFace: FONT, fontSize: 12.5, color: INK, align: "left", margin: 0,
      valign: "middle", bullet: { code: "2713", indent: 14 } });
  });

  // KPI figure + honest bottom line
  fitImg(s, path.join(RSFIG, "n255_kpi_bars.png"), AR.kpi,
    M, 4.75, 6.4, 2.15, "left");

  const bx = 7.2, bw = W - bx - M;
  card(s, bx, 4.75, bw, 2.15, BROWN_TINT, BROWN);
  s.addText("一句话结论", { x: bx + 0.2, y: 4.88, w: bw - 0.4, h: 0.4,
    fontFace: FONT, fontSize: 14, bold: true, color: BROWN, align: "left", margin: 0 });
  s.addText([
    { text: "增益换延迟：", options: { bold: true, color: BROWN } },
    { text: "比软判基线 LCC-BR，延迟持平甚至更低（KPI 达标）；比硬判基线 BM，软判法必然更贵。要满足硬判 KPI，用 Direct 硬判路线，以较小编码增益代价换低延迟。", options: {} },
  ], { x: bx + 0.2, y: 5.3, w: bw - 0.4, h: 1.5, fontFace: FONT, fontSize: 12.5,
       color: INK, align: "left", margin: 0, valign: "top", lineSpacingMultiple: 1.2 });
  s.addNotes("传统 vs 我们。传统：内码BCH硬判先译，再喂给外码RS；OSD重编码用高斯消元，串行、难并行、延迟高，内外码不共享。我们：内码LLOSD软判、外码LCC-BR/BM，纠错增益≥1dB；用Lagrange插值免主元可并行、延迟低；内外码共享代数结构省算力。底部诚实结论：这是拿增益换延迟——对软判基线达标，对硬判基线必然更贵，需Direct硬判路线。左下是KPI柱状图。");
})();

// ============================================================ SLIDE 8 — 总结 & 展望
(function () {
  const s = pres.addSlide();
  s.background = { color: WHITE };
  topBand(s, GREEN);
  s.addText("总结 & 下一步", {
    x: M, y: 0.55, w: W - 2 * M, h: 0.9, fontFace: FONT, fontSize: 32, bold: true,
    color: GREEN_DARK, align: "left", margin: 0,
  });

  const items = [
    ["做了什么", GREEN,
      "在 PAM4-AWGN 全链路上实现 RS+BCH 级联码：外码 RS 抗突发、内码 BCH 纠随机错，编码→调制→信道→两级译码闭环可跑。"],
    ["核心创新", GREEN,
      "用 Lagrange 插值替代 OSD 的高斯消元（免主元、可并行、关键路径短），内外码共享有限域代数结构进一步省算力。"],
    ["交织", GREEN,
      "复现 APCC-2022 三步矩阵交织，w=1bit 把突发打散到多码字、每字≤1错，零码率代价的抗突发增益。"],
    ["诚实结论", BROWN,
      "开销名义 12%、实测有效约 17–18%（零填充）；延迟对软判基线达标、对硬判基线偏贵；BER 低 SNR 有门限、高 SNR 反超；内码建议 t≥2。"],
  ];
  const y0 = 1.7, rh = 1.18;
  items.forEach((it, i) => {
    const y = y0 + i * rh;
    badge(s, M, y + 0.08, i + 1, 0.32, it[1]);
    s.addText(it[0], { x: M + 0.85, y: y, w: 2.4, h: 0.5, fontFace: FONT,
      fontSize: 16, bold: true, color: GREEN_DARK, align: "left", margin: 0, valign: "middle" });
    s.addText(it[2], {
      x: M + 3.35, y: y - 0.04, w: W - M - 3.35 - M, h: rh - 0.12,
      fontFace: FONT, fontSize: 13, color: INK, align: "left", margin: 0,
      valign: "middle", lineSpacingMultiple: 1.12 });
  });

  card(s, M, 6.4, W - 2 * M, 0.75, GREEN_WASH, GREEN_75);
  s.addText([
    { text: "下一步：", options: { bold: true, color: GREEN_DARK } },
    { text: "① 内码升到 BCH t≥2 提升级联增益；② P=64 并行 + Lagrange 共享压延迟；③ 补软判 Chase 交织增益；④ 找精确整除码型逼近真 12% 开销。", options: { color: INK } },
  ], { x: M + 0.25, y: 6.45, w: W - 2 * M - 0.5, h: 0.65, fontFace: FONT,
       fontSize: 12, align: "left", margin: 0, valign: "middle", lineSpacingMultiple: 1.05 });
  s.addNotes("总结四点：做了什么(全链路级联码闭环)、核心创新(Lagrange替代高斯消元+共享)、交织(APCC2022三步交织抗突发)、诚实结论(开销实测17-18%、延迟看基线、BER有门限、建议t≥2)。下一步：升内码t、并行压延迟、补软判交织、找整除码型。结束。");
})();

