        </mxCell>
        <mxCell id="lat_title" parent="1" style="text;html=1;fillColor=none;strokeColor=none;align=left;fontSize=14;fontStyle=1;fontColor=#015C31;spacingLeft=4;" value="③ 总时延与创新点分解" vertex="1">
          <mxGeometry height="26" width="500" x="80" y="870" as="geometry" />
        </mxCell>
        <mxCell id="lat_formula" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBF7;strokeColor=#14AE68;strokeWidth=1.75;fontSize=14;align=left;spacingLeft=14;spacingTop=8;arcSize=6;" value="T_Cascade = T_BCH + T_RS-BM − ΔLagrange&#xa;&#xa;• T_RS-BM = 2t + 3 cyc  （Config 1: 33 · Config 2: 19）&#xa;• T_BCH ∈ {Conv, Direct}  （见上方 ① ）&#xa;• ΔLagrange = 0（无共享） / 1（共享 syndrome） / 2（再共享 GF 乘法器阵列）&#xa;&#xa;KPI 门槛：T_Cascade ≤ 1.10 · T_RS-BM" vertex="1">
          <mxGeometry height="180" width="750" x="80" y="900" as="geometry" />
        </mxCell>
        <mxCell id="c1_res" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F0;strokeColor=#009A44;strokeWidth=2;fontSize=14;align=left;spacingLeft=14;spacingTop=8;arcSize=6;fontFamily=Menlo;fontColor=#015C31;" value="Config 1（KP4）· Pure RS-BM = 33 cyc&#xa;&#xa;Cascade Conv       37 cyc   +12.1%  ✗&#xa;Cascade Direct     35 cyc   +6.1%   ✓&#xa;+ 共享 syndrome    34 cyc   +3.0%   ✓&#xa;+ 再共享乘法器     33 cyc   +0.0%   ✓&#xa;&#xa;→ 仅需 Direct 即达标（外码大 · 内码小）" vertex="1">
          <mxGeometry height="180" width="430" x="850" y="900" as="geometry" />
        </mxCell>
        <mxCell id="c2_res" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEE6;strokeColor=#A23E0A;strokeWidth=2;fontSize=14;align=left;spacingLeft=14;spacingTop=8;arcSize=6;fontFamily=Menlo;fontColor=#A23E0A;" value="Config 2（n=255）· Pure RS-BM = 19 cyc&#xa;&#xa;Cascade Conv       27 cyc   +42.1%  ✗&#xa;Cascade Direct     22 cyc   +15.8%  ✗&#xa;+ 共享 syndrome    21 cyc   +10.5%  ✗&#xa;+ 再共享乘法器     20 cyc   +5.3%   ✓&#xa;&#xa;→ 需 Direct + 二级共享齐全达标" vertex="1">
          <mxGeometry height="180" width="430" x="1290" y="900" as="geometry" />
        </mxCell>
        <mxCell id="lg_badge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEE;strokeColor=#C08A00;strokeWidth=2;fontSize=14;align=left;spacingLeft=12;spacingTop=6;arcSize=6;fontColor=#7A5B00;" value="创新点：Lagrange 硬件共享&#xa;• 一级：内外码共享 syndrome 计算单元 → 省 1 cyc&#xa;• 二级：进一步共享 GF(2ᵐ) 乘法器阵列 → 再省 1 cyc" vertex="1">
          <mxGeometry height="70" width="750" x="80" y="1095" as="geometry" />
